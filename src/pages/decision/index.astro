---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";

// The site's greys, with the warm and teal accents of its ASCII banners.
const theme = {
  name: "jacques-mono",
  type: "dark",
  colors: { "editor.background": "#0c0c0c", "editor.foreground": "#d6d4cf" },
  tokenColors: [
    { settings: { foreground: "#d6d4cf" } },
    { scope: ["comment", "punctuation.definition.comment"], settings: { foreground: "#5e5e5e", fontStyle: "italic" } },
    { scope: ["keyword", "storage", "storage.type", "keyword.control"], settings: { foreground: "#ffffff" } },
    { scope: ["string", "string.quoted", "punctuation.definition.string"], settings: { foreground: "#6fbfb0" } },
    { scope: ["constant.numeric", "constant.language"], settings: { foreground: "#e0914f" } },
    { scope: ["entity.name.function", "support.function", "meta.function-call entity.name.function"], settings: { foreground: "#ffffff" } },
    { scope: ["entity.name.type", "support.class", "entity.name.class", "variable.other.constant"], settings: { foreground: "#e0914f" } },
    { scope: ["meta.object-literal.key", "support.type.property-name", "variable.other.property"], settings: { foreground: "#a8a6a1" } },
    { scope: ["punctuation", "meta.brace", "keyword.operator"], settings: { foreground: "#7a7a7a" } },
  ],
};

const code = `const model = await Decision.load(url);
const { answers } = await model.systemOne(ticket, {
  topic: { type: "choice", instructions: "What is the topic?",
           criteria: { billing: null, delivery: null } },
  churn: { type: "noul",   instructions: "Is the customer about to leave?" },
});
// answers.churn → { noul: 0.83 }`;
---
<Base title="decision.js — Jacques" description="decision.js, an experiment: fast WebGPU inference for System One decision models, in the browser.">
  <main class="page">
    <p class="eyebrow">Experiment — WebGPU</p>
    <h1>decision.js</h1>
    <p class="lede">
      An experiment: how fast can a browser run <strong>System One</strong> models? These are small models that
      make quick decisions (yes / no, pick an option, give a score) instead of writing text. decision.js is a
      small WebGPU inference engine written from scratch for them.
    </p>
    <div class="cta">
      <a class="btn primary" href="/decision/playground">View playground →</a>
      <a class="btn" href="https://github.com/Jacqkues/decision.js">View code</a>
    </div>

    <figure class="flow" aria-label="A state and questions go into the model on the GPU, which returns a probability per option">
      <div class="inputs">
        <div class="node"><span class="k">State</span><span>a ticket, a form, any JSON</span></div>
        <div class="node"><span class="k">Questions</span><span>yes / no · choice · score</span></div>
      </div>
      <div class="arrow" aria-hidden="true"></div>
      <div class="node model"><span class="k">Model · WebGPU</span><span>d1 or d3-lite, one forward pass, no text generated</span></div>
      <div class="arrow" aria-hidden="true"></div>
      <div class="node out">
        <span class="k">Answers</span>
        <span class="bar"><i>delivery</i><b style="--w: 96%"></b><em>96%</em></span>
        <span class="bar"><i>billing</i><b style="--w: 3%"></b><em>3%</em></span>
        <span class="bar"><i>bug</i><b style="--w: 1%"></b><em>1%</em></span>
      </div>
    </figure>

    <div class="prose">
      <h2>So far</h2>
      <ul>
        <li><strong>34 ms</strong> for 3 decisions on a support ticket with d1-omni (Apple M5 Pro, Chrome).</li>
        <li>About <strong>2× faster</strong> than Google's LiteRT.js on the same model.</li>
        <li>Answers that <strong>match</strong> the models' official PyTorch code, and nothing leaves the page.</li>
      </ul>
      <Code code={code} lang="ts" theme={theme} />
    </div>
  </main>
</Base>

<style>
  .page { max-width: 52rem; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); letter-spacing: -0.02em; }
  .lede { color: #d6d4cf; font-size: 1rem; margin: 1rem 0 2rem; max-width: 42rem; }
  .lede strong { color: var(--ink); font-weight: 300; }

  .cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .btn {
    font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 0.95rem 1.5rem; border: 1px solid var(--dim); color: var(--ink);
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .btn:hover { border-color: var(--ink); background: #161616; }
  .btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn.primary:hover { background: transparent; color: var(--ink); }

  /* the diagram: inputs → model → answers, stacked on small screens */
  .flow { margin: 3.5rem 0 1rem; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 0; }
  .inputs { display: grid; gap: 0.6rem; }
  .node { border: 1px solid var(--subtle); padding: 0.8rem 0.9rem; display: grid; gap: 0.3rem; font-size: 0.78rem; color: var(--dim); background: #070707; }
  .k { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); }
  .model { border-color: #e0914f; }
  .model .k { color: #e0914f; }
  .arrow { width: 2.2rem; height: 1px; background: var(--subtle); position: relative; }
  .arrow::after { content: ""; position: absolute; right: -1px; top: -3px; border: 3.5px solid transparent; border-left: 6px solid var(--subtle); border-right: 0; }
  .bar { display: grid; grid-template-columns: 4.2rem 1fr 2.4rem; gap: 0.5rem; align-items: center; }
  .bar i { font-style: normal; }
  .bar b { height: 2px; background: linear-gradient(90deg, var(--ink) var(--w), var(--line) var(--w)); }
  .bar em { font-style: normal; text-align: right; font-variant-numeric: tabular-nums; }
  .bar:nth-of-type(2) { color: var(--ink); }
  @media (max-width: 46rem) {
    .flow { grid-template-columns: 1fr; justify-items: stretch; }
    .arrow { width: 1px; height: 1.6rem; justify-self: center; }
    .arrow::after { right: -3px; top: auto; bottom: -1px; border: 3.5px solid transparent; border-top: 6px solid var(--subtle); border-bottom: 0; }
  }

  .prose { margin-top: 1rem; }
  .prose :global(pre.astro-code) { background: #0c0c0c !important; }
</style>
