---
// The decision.js hero: a state is typed in, then d3-lite's answers fill in, one scenario after another.
// The probabilities are d3-lite's own (exact mode, measured in the playground on an Apple M5 Pro).
---
<figure class="demo" aria-label="d3-lite answering typed questions about a support ticket, a tool request and a comment">
  <figcaption class="bar">
    <span>d3-lite · WebGPU</span>
    <span class="meta" data-meta></span>
  </figcaption>
  <div class="body">
    <p class="label">State</p>
    <p class="state"><span data-state></span><span class="caret" data-caret></span></p>
    <div data-answers></div>
  </div>
</figure>

<style>
  .demo { margin: 0; border: 1px solid var(--subtle); background: #070707; font-size: 0.78rem; }
  .bar {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.6rem 1rem; border-bottom: 1px solid var(--line);
    font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim);
  }
  .meta { color: #e0914f; font-variant-numeric: tabular-nums; }
  .body { padding: 1rem 1rem 1.2rem; min-height: 25rem; }
  .label { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--subtle); margin-bottom: 0.35rem; }
  .state { color: #6fbfb0; min-height: 4.8em; line-height: 1.6; }
  .caret { display: inline-block; width: 0.5em; height: 1em; margin-left: 1px; vertical-align: -0.12em; background: var(--ink); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .body :global(.q) { margin-top: 0.9rem; opacity: 0; transform: translateY(4px); transition: opacity 0.35s, transform 0.35s; }
  .body :global(.q.on) { opacity: 1; transform: none; }
  .body :global(.q h3) { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.3rem; display: flex; gap: 0.7rem; align-items: baseline; }
  .body :global(.q h3 b) { font-weight: 300; font-size: 0.85rem; letter-spacing: 0.02em; text-transform: none; color: var(--ink); }
  .body :global(.r) { display: grid; grid-template-columns: 7.5rem 1fr 3.2rem; gap: 0.7rem; align-items: center; color: var(--subtle); line-height: 1.5; }
  .body :global(.r.best) { color: var(--ink); }
  .body :global(.r span:first-child) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .body :global(.t) { height: 2px; background: var(--line); }
  .body :global(.f) { height: 100%; width: 0; background: var(--subtle); transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .body :global(.r.best .f) { background: #e0914f; }
  .body :global(.n) { text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 30rem) { .body :global(.r) { grid-template-columns: 5.5rem 1fr 3rem; } }
</style>

<script>
  type Q = [name: string, rows: [string, number][]];
  const scenarios: { state: string; ms: number; qs: Q[] }[] = [
    {
      state: "Hi, I ordered a laptop three weeks ago and it still hasn't arrived. If I don't get it by Friday I'm cancelling my subscription.",
      ms: 104,
      qs: [
        ["topic", [["billing", 0.004], ["delivery", 0.957], ["bug", 0.001], ["account", 0], ["other", 0.037]]],
        ["churn", [["yes", 0.828], ["no", 0.172]]],
        ["urgency", [["low", 0.194], ["medium", 0.45], ["high", 0.356]]],
      ],
    },
    {
      state: "Can you book me a table for two at an Italian place near the office tomorrow around 8pm, and remind me an hour before?",
      ms: 91,
      qs: [
        ["tool", [["search_web", 0], ["book_restaurant", 0.985], ["send_email", 0.002], ["get_weather", 0], ["set_reminder", 0.013]]],
        ["several_actions", [["yes", 0.787], ["no", 0.213]]],
        ["complexity", [["simple", 0.482], ["moderate", 0.466], ["complex", 0.051]]],
      ],
    },
    {
      state: '{ "comment": "Honestly anyone still buying these is an idiot. Go back to your cave.", "reports": 3 }',
      ms: 75,
      qs: [
        ["toxic", [["yes", 0.764], ["no", 0.236]]],
        ["action", [["keep", 0.185], ["warn", 0.245], ["hide", 0.183], ["ban", 0.388]]],
      ],
    },
  ];

  const root = document.querySelector<HTMLElement>(".demo")!;
  const stateEl = root.querySelector<HTMLElement>("[data-state]")!, caret = root.querySelector<HTMLElement>("[data-caret]")!;
  const answers = root.querySelector<HTMLElement>("[data-answers]")!, meta = root.querySelector<HTMLElement>("[data-meta]")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

  const html = (qs: Q[]) => qs.map(([name, rows]) => {
    const best = rows.reduce((a, b) => (b[1] > a[1] ? b : a))[0];
    return `<div class="q"><h3>${esc(name)} <b>${esc(best)}</b></h3>${rows.map(([k, p]) =>
      `<div class="r${k === best ? " best" : ""}"><span>${esc(k)}</span><div class="t"><div class="f" data-w="${(100 * p).toFixed(1)}"></div></div><span class="n">${(100 * p).toFixed(1)}%</span></div>`).join("")}</div>`;
  }).join("");
  const reveal = (q: HTMLElement) => { q.classList.add("on"); q.querySelectorAll<HTMLElement>(".f").forEach((f) => (f.style.width = `${f.dataset.w}%`)); };

  async function play(i: number) {
    const s = scenarios[i % scenarios.length]!;
    answers.innerHTML = "";
    meta.textContent = "";
    caret.hidden = false;
    for (let k = 1; k <= s.state.length; k++) { stateEl.textContent = s.state.slice(0, k); await wait(16); }
    meta.textContent = "deciding…";
    await wait(350);
    caret.hidden = true;
    answers.innerHTML = html(s.qs);
    meta.textContent = `${s.qs.length} decisions · ${s.ms} ms`;
    for (const q of answers.querySelectorAll<HTMLElement>(".q")) { await wait(30); reveal(q); await wait(180); }
    await wait(4200);
    play(i + 1);
  }

  if (still) {
    const s = scenarios[0]!;
    stateEl.textContent = s.state;
    caret.hidden = true;
    answers.innerHTML = html(s.qs);
    meta.textContent = `${s.qs.length} decisions · ${s.ms} ms`;
    answers.querySelectorAll<HTMLElement>(".q").forEach(reveal);
  } else play(0);
</script>
